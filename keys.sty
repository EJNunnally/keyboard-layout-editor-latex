%%% Identification - declare the package
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{keys}[2026/07/26 Keys Package]

%%% Preliminary declarations - import external packages, write commands needed for options
\RequirePackage{tikz}
\usetikzlibrary{calc}
\usetikzlibrary{backgrounds}
\RequirePackage{fontspec} % needs either xelatex or lualatex compiler
% \RequirePackage[os=win]{menukeys} % nice, but I wanted to make a few tweaks
\RequirePackage{mymenukeys}
\setsansfont{Helvetica}
\renewcommand{\familydefault}{\sfdefault}
\fontsize{12pt}{12pt}\selectfont % Please note that the front labels are 10pt

\newlength{\baseBorderRadius}
\newlength{\topBorderRadius}
\newlength{\U}
\newlength{\keyLabelWidth}
\newlength{\keyLabelHeight}

\setlength{\fboxsep}{0pt}
\setlength{\baseBorderRadius}{5pt}
\setlength{\topBorderRadius}{3pt}
\setlength{\U}{54pt}
% \newcommand{\spacehelper}{\phantom{lg}} % replaced by \strut

% default keyboard colors
\definecolor{basecolor}{RGB}{\inteval{12*16+12},\inteval{12*16+12},\inteval{12*16+12}} % CCCCCC
\definecolor{topcolor}{RGB}{\inteval{15*16+12},\inteval{15*16+12},\inteval{15*16+12}} % FCFCFC
\definecolor{bordercolor}{RGB}{\inteval{11*16+8},\inteval{11*16+8},\inteval{11*16+8}} % B8B8B8
\definecolor{legendcolor}{RGB}{8,8,8} % 080808
\definecolor{bgcolor}{RGB}{\inteval{14*16+14},\inteval{14*16+14},\inteval{14*16+14}} % EEEEEE
\definecolor{bgbordercolor}{RGB}{\inteval{13*16+13},\inteval{13*16+13},\inteval{13*16+13}} % DDDDDD

% call keyboard colors
\newcommand{\keyBaseColor}{basecolor}
\newcommand{\keyTopColor}{topcolor}
\newcommand{\keyBorderColor}{bordercolor}

% key position and dimensions
\newcommand{\keyX}{0}
\newcommand{\keyY}{0}
\newcommand{\keyWidth}{1} % Assume \keyWidth >= 1
\newcommand{\keyHeight}{1} % Assume \keyHeight >= 1
\newcommand{\keyRotationCenterX}{0}
\newcommand{\keyRotationCenterY}{0}
\newcommand{\keyRotationAngle}{0} % \keyRotationAngle is in degrees

% background position and dimensions
\newcommand{\backgroundX}{}
\newcommand{\backgroundY}{}
\newcommand{\backgroundWidth}{}
\newcommand{\backgroundHeight}{}

% ! key legends: This might be changed or removed
% TODO: make front legends (just for kicks)
\newcommand{\topLeftLegend}{}
\newcommand{\topCenterLegend}{}
\newcommand{\topRightLegend}{}
\newcommand{\centerLeftLegend}{}
\newcommand{\centerCenterLegend}{}
\newcommand{\centerRightLegend}{}
\newcommand{\bottomLeftLegend}{}
\newcommand{\bottomCenterLegend}{}
\newcommand{\bottomRightLegend}{}

\NewDocumentCommand{\placeKey}{mmO{1}O{1}} {
    \setKeyPosition{#1}{#2}
    \setKeyDimension{#3}{#4}
    \keyCoords
    \filldraw[draw=black,rounded corners=\baseBorderRadius, fill=\keyBaseColor, line width=1pt] (basenorthwest) rectangle (basesoutheast);
    \filldraw[draw=\keyBorderColor, rounded corners=\topBorderRadius, fill=\keyTopColor, line width=1pt] (topnorthwest) rectangle (topsoutheast);
    \keyDebug
}

\NewDocumentCommand{\setKeyPosition}{mm}{
    \renewcommand{\keyX}{#1}
    \renewcommand{\keyY}{\fpeval{-#2}}
}

\NewDocumentCommand{\setKeyDimension}{mm}{
    \renewcommand{\keyWidth}{#1}
    \renewcommand{\keyHeight}{#2}
}

% TODO: update \placeKey so that keys can rotate; may need to use scopes; look at dm2_pcb_print in Overleaf
\NewDocumentCommand{\setKeyRotation}{mmm}{
    \renewcommand{\keyRotationCenterX}{#1}
    \renewcommand{\keyRotationCenterY}{#2}
    \renewcommand{\keyRotationAngle}{#3}
}

\NewDocumentCommand{\keyLabel}{mm}{
    \node[] () at (labelcenter) {
        \mbox{%
            \parbox[#1][\keyLabelHeight][#1]{\keyLabelWidth}{#2\strut}%
        }
    };
}

\NewDocumentCommand{\topLabel}{m}{
    \keyLabel{t}{#1}
}

\NewDocumentCommand{\centerLabel}{m}{
    \keyLabel{c}{#1}
}

\NewDocumentCommand{\bottomLabel}{m}{
    \keyLabel{b}{#1}
}

\NewDocumentCommand{\setKeyTopLeft}{m}{
    \renewcommand{\topLeftLegend}{#1}
    \topLabel{\raggedright\topLeftLegend}
}

\NewDocumentCommand{\setKeyTopCenter}{m}{
    \renewcommand{\topCenterLegend}{#1}
    \topLabel{\centering\topCenterLegend}
}

\NewDocumentCommand{\setKeyTopRight}{m}{
    \renewcommand{\topRightLegend}{#1}
    \topLabel{\raggedleft\topCenterLegend}
}

\NewDocumentCommand{\setKeyCenterLeft}{m}{
    \renewcommand{\centerLeftLegend}{#1}
    \centerLabel{\raggedright\centerLeftLegend}
}

\NewDocumentCommand{\setKeyCenterCenter}{m}{
    \renewcommand{\centerCenterLegend}{#1}
    \centerLabel{\centering\centerCenterLegend}
}

\NewDocumentCommand{\setKeyCenterRight}{m}{
    \renewcommand{\centerRightLegend}{#1}
    \centerLabel{\raggedleft\centerRightLegend}
}

\NewDocumentCommand{\setKeyBottomLeft}{m}{
    \renewcommand{\bottomLeftLegend}{#1}
    \bottomLabel{\raggedright\bottomLeftLegend}
}

\NewDocumentCommand{\setKeyBottomCenter}{m}{
    \renewcommand{\bottomCenterLegend}{#1}
    \bottomLabel{\centering\bottomCenterLegend}
}

\NewDocumentCommand{\setKeyBottomRight}{m}{
    \renewcommand{\bottomRightLegend}{#1}
    \bottomLabel{\raggedleft\bottomRightLegend}
}

\NewDocumentCommand{\setKeyColors}{mmm}{
    \renewcommand{\keyBaseColor}{#1}
    \renewcommand{\keyTopColor}{#2}
    \renewcommand{\keyBorderColor}{#3}
}

\NewDocumentCommand{\resetKeyColors}{}{
    \renewcommand{\keyBaseColor}{basecolor}
    \renewcommand{\keyTopColor}{topcolor}
    \renewcommand{\keyBorderColor}{bordercolor}
}

\NewDocumentCommand{\keyCoords}{} {
    % set some parameters because I can't read messy length calculations
    \coordinate (keycenter) at (\keyX\U,\keyY\U);
    \coordinate (truecenter) at ($(keycenter) + (\fpeval{0.5*(\keyWidth-1)}\U,-\fpeval{0.5*(\keyHeight-1)}\U)$);
    \coordinate (labelcenter) at ($(truecenter) + (0,3pt)$);
    \coordinate (labelnorthwest) at ($(labelcenter) + (-18pt,18pt) + (-\fpeval{0.5*(\keyWidth-1)}\U,\fpeval{0.5*(\keyHeight-1)}\U)$);
    \coordinate (labelsoutheast) at ($(labelcenter) + (18pt,-18pt) + (\fpeval{0.5*(\keyWidth-1)}\U,-\fpeval{0.5*(\keyHeight-1)}\U)$);
    \coordinate (topnorthwest) at ($(labelnorthwest) + (-3pt,3pt)$);
    \coordinate (topsoutheast) at ($(labelsoutheast) + (3pt,-3pt)$);
    \coordinate (basenorthwest) at ($(keycenter) + (-0.5\U,0.5\U)$);
    \coordinate (basesoutheast) at ($(keycenter) + (\keyWidth\U,-\keyHeight\U) + (-0.5\U,0.5\U)$);
    \coordinate (basesoutheast) at ($(basenorthwest) + (\keyWidth\U,-\keyHeight\U)$);
    \setlength{\keyLabelWidth}{\dimeval{\keyWidth\U-18pt}}
    \setlength{\keyLabelHeight}{\dimeval{\keyHeight\U-18pt}}
}

\NewDocumentCommand{\keyDebug}{}{
    % \draw[red] (labelnorthwest) rectangle (labelsoutheast); % Are my labels extending to where they should be?
    % \fill[red] (keycenter) circle (1pt) node {\tiny{keycenter}}; % Where is the key's position?
    % \fill[red] (truecenter) circle (1pt) node {\tiny{truecenter}}; % Where is the center of the key?
    % \fill[red] (labelcenter) circle (1pt) node {\tiny{labelcenter}}; % Where is the center of the key?
}

\NewDocumentCommand{\setBackgroundPosition}{mm}{ % this should be the position of the top left key
    \renewcommand{\backgroundX}{#1}
    \renewcommand{\backgroundY}{#2}
}

\NewDocumentCommand{\setBackgroundDimension}{mm}{
    \renewcommand{\backgroundWidth}{#1}
    \renewcommand{\backgroundHeight}{#2}
}

\NewDocumentCommand{\placeBackground}{mmmm}{ % this is placed in the background layer
    \setBackgroundPosition{#1}{#2}
    \setBackgroundDimension{#3}{#4}
    \coordinate (backgroundcenter) at (\backgroundX\U,\backgroundY\U);
    \coordinate (backgroundnorthwest) at ($(backgroundcenter) + (-0.5\U,0.5\U) + (-10pt,10pt)$);
    \coordinate (backgroundsoutheast) at ($(backgroundcenter) + (\fpeval{\backgroundWidth - 1}\U,-\fpeval{\backgroundHeight - 1}\U) + (0.5\U,-0.5\U) + (10pt,-10pt)$);
    \begin{scope}[on background layer]
        \filldraw[fill=bgcolor, draw=bgbordercolor, rounded corners=0pt, line width=1pt] (backgroundnorthwest) rectangle (backgroundsoutheast);
    \end{scope}
}

%%% Options - declare and process options
\DeclareOption{Denelson}{
    % \setsansfont{Arial} % looks more like Helvetica than Arial imo
    \setlength{\baseBorderRadius}{0pt}
    \setlength{\topBorderRadius}{0pt}

    % default keyboard colors; no top, border, or background colors
    \definecolor{basecolor}{RGB}{255,255,255} % FFFFFF
    \definecolor{modcolor1}{RGB}{240,240,240} % F0F0F0
    \definecolor{modcolor2}{RGB}{224,224,224} % E0E0E0
    \definecolor{legendcolor}{RGB}{0,0,0} % 000000
    \NewDocumentCommand{\superKey}{}{
        \renewcommand{\keyBaseColor}{modcolor1}
    }

    \NewDocumentCommand{\modKey}{}{
        \renewcommand{\keyBaseColor}{modcolor2}
    }

    \RenewDocumentCommand{\keyCoords}{} {
        \coordinate (keycenter) at (\keyX\U,\keyY\U);
        \coordinate (truecenter) at ($(keycenter) + (\fpeval{0.5*(\keyWidth-1)}\U,-\fpeval{0.5*(\keyHeight-1)}\U)$);
        \coordinate (labelcenter) at (truecenter);
        \coordinate (labelnorthwest) at ($(labelcenter) + (-21pt,21pt) + (-\fpeval{0.5*(\keyWidth-1)}\U,\fpeval{0.5*(\keyHeight-1)}\U)$);
        \coordinate (labelsoutheast) at ($(labelcenter) + (21pt,-21pt) + (\fpeval{0.5*(\keyWidth-1)}\U,-\fpeval{0.5*(\keyHeight-1)}\U)$);
        \coordinate (basenorthwest) at ($(keycenter) + (-0.5\U,0.5\U)$);
        \coordinate (basesoutheast) at ($(basenorthwest) + (\keyWidth\U,-\keyHeight\U)$);
        \setlength{\keyLabelWidth}{\dimeval{\keyWidth\U-12pt}}
        \setlength{\keyLabelHeight}{\dimeval{\keyHeight\U-12pt}}
    }

    \RenewDocumentCommand{\placeKey}{mmO{1}O{1}} {
        \setKeyPosition{#1}{#2}
        \setKeyDimension{#3}{#4}
        \keyCoords
        \filldraw[draw=black,rounded corners=\baseBorderRadius, fill=\keyBaseColor, line width=1pt] (basenorthwest) rectangle (basesoutheast);
        \keyDebug
    }

    \RenewDocumentCommand{\setKeyTopLeft}{m}{
        \renewcommand{\topLeftLegend}{#1}
        \topLabel{\raggedright\textbf\topLeftLegend}
    }

    \RenewDocumentCommand{\setKeyCenterCenter}{m}{
        \renewcommand{\topLeftLegend}{#1}
        \centerLabel{\centering\textbf\topLeftLegend}
    }

    \RenewDocumentCommand{\setKeyBottomLeft}{m}{
        \renewcommand{\bottomLeftLegend}{#1}
        \bottomLabel{\raggedright\textbf\bottomLeftLegend}
    }

}

\ProcessOptions\relax
\AtBeginDocument{\color{legendcolor}}
