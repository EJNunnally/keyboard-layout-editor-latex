\NewDocumentCommand{\key}{mmO{1}O{1}} {
    \coordinate (keycenter) at (#1\U,-#2\U);
    \coordinate (truecenter) at ($(keycenter) + (\fpeval{0.5*(#3-1)}\U,-\fpeval{0.5*(#4-1)}\U)$);

    \draw[rounded corners=5pt,fill=basecolor,line width=1pt] ($(keycenter) + (-0.5\U,0.5\U)$) rectangle ($(keycenter) + (#3\U,-#4\U) + (-0.5\U,0.5\U)$);

    \draw[bordercolor,rounded corners=3pt,fill=topcolor, line width=1pt] ($(keycenter) + (-21pt,-18pt) + (0,-\inteval{#4-1}\U) $) rectangle ($(keycenter) + (21pt,24pt) + (\inteval{#4-1}\U,0)$);

    % \node[anchor=south west,align=left] () at ($(keycenter) + (-18pt,-15pt) + (0,-\inteval{#4-1}\U)$) {\textcolor{legendcolor}{\textsf{R4;}}}; % bottom left legend

    % \node[anchor=north west,align=left] () at ($(keycenter) + (-0.5\U,0.5\U) + (1.5mm,-1.5mm)$) {\textcolor{legendcolor}{\textsf{:}}}; % top left legend

    \node[] () at ($(truecenter) + (0,3pt)$) {
        \mbox{%
            \parbox[t][\fpeval{(2/3)+#4-1}\U][t]{\fpeval{(2/3)+#4-1}\U}{%
                \raggedright
                \textcolor{legendcolor}{\textsf{:}}\phantom{R;} % phantom is helping with the vertical inline spacing
            }%
        }
    }; % top left legend

    \node[] () at ($(truecenter) + (0,3pt)$) {
        \mbox{%
            \parbox[b][\fpeval{(2/3)+#4-1}\U][b]{\fpeval{(2/3)+#4-1}\U}{%
                \raggedright
                \textcolor{legendcolor}{\textsf{R4}}\phantom{R;}
            }%
        }
    }; % bottom left legend

    \node[] () at ($(truecenter) + (0,3pt)$) {
        \mbox{%
            \parbox[b][\fpeval{(2/3)+#4-1}\U][b]{\fpeval{(2/3)+#4-1}\U}{%
                \raggedleft
                \phantom{R;}\textcolor{legendcolor}{\textsf{R4;}}
            }%
        }
    }; % bottom right legend
}
